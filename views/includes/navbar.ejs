                            <select class="form-select" name="sortBy" style="border-radius: 8px;">
                                <option value="">Default sorting</option>
                                <option value="priceLowToHigh">Price: Low to High</option>
                                <option value="priceHighToLow">Price: High to Low</option>
                            </select>
                        </div>

                        <button class="btn btn-primary-custom w-100 mt-2" type="submit" style="padding: 0.5rem;">
