                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary-custom w-100" href="/login"><i class="fa-solid fa-right-to-bracket me-1"></i> Login</a>
                    </li>
                <% } else { %>
                    <li class="nav-item d-flex align-items-center me-2 text-dark font-semibold">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--primary-gradient); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; margin-right: 8px; box-shadow: 0 2px 6px var(--primary-glow);">
                            <%= currentUser.username[0].toUpperCase() %>
                        </div>
                        <span class="fw-semibold">Hello, <strong style="color: var(--primary);"><%= currentUser.username %></strong></span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-custom w-100" href="/logout"><i class="fa-solid fa-power-off me-1"></i> Logout</a>
                    </li>
