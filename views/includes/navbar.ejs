                        <div class="fw-bold text-dark border-bottom pb-2 mb-1" style="font-size: 0.9rem;">
                            <i class="fa-solid fa-sliders me-1"></i> Advanced Filters
                        </div>
                        <input type="hidden" name="q" value="">
                        
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label text-muted fw-bold" style="font-size: 0.75rem; text-transform: uppercase;">Min Price (₹)</label>
                                <input class="form-control" type="number" name="minPrice" placeholder="Min" style="border-radius: 8px;">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted fw-bold" style="font-size: 0.75rem; text-transform: uppercase;">Max Price (₹)</label>
                                <input class="form-control" type="number" name="maxPrice" placeholder="Max" style="border-radius: 8px;">
                            </div>
                        </div>

